# Copy to .env and adjust for local dev. Never commit a real .env file.
# Secrets (API keys, tokens) should be stored in the OS keyring, not here -
# see src/qat/security.py. Anything placed here is a non-secret default only.

# --- Trading mode -----------------------------------------------------
# paper (default, safe) | live (requires deliberate opt-in + in-app confirmation)
QAT_TRADING_MODE=paper

# --- Storage ------------------------------------------------------------
# sqlite (default, local dev, zero setup) | timescale (requires docker-compose up)
QAT_STORAGE_BACKEND=sqlite
QAT_DATABASE_URL=sqlite:///./qat.db
# QAT_DATABASE_URL=postgresql+psycopg://qat:qat@localhost:5433/qat

# --- IBKR (paper Gateway/TWS defaults) -----------------------------------
QAT_IBKR_HOST=127.0.0.1
QAT_IBKR_PORT=4002
QAT_IBKR_CLIENT_ID=1

# --- AI provider (M10; Settings screen writes these for you - see README) ---
# Each LLMRouter slot's provider is independent: anthropic | local | demo
QAT_GENERAL_REQUEST_PROVIDER=demo
QAT_SENSITIVE_REQUEST_PROVIDER=demo
QAT_LOCAL_LLM_BASE_URL=http://localhost:1234/v1
QAT_LOCAL_LLM_MODEL=local-model

# --- Market & watchlist (M10; Settings screen writes these for you) --------
# US | ASX
QAT_MARKET=US
# curated | etf | megacap
QAT_WATCHLIST_CATEGORY=curated
QAT_WATCHLIST_CURATED_US=SPY,AAPL,MSFT,GOOGL
QAT_WATCHLIST_CURATED_ASX=STW.AX,BHP.AX,CBA.AX,CSL.AX
QAT_WATCHLIST_MAX_SYMBOLS=10
QAT_WATCHLIST_MIN_AVG_VOLUME=100000

# --- Order policy (M11) ----------------------------------------------------
# Long-only by default: a "sell" only ever closes an existing holding, and a
# sell signal for a symbol you hold nothing in is dropped rather than shorted.
QAT_ALLOW_SHORT_SELLING=false
# Caps rendered blotter rows; order history itself is never truncated.
QAT_BLOTTER_MAX_ROWS=500

# --- Logging --------------------------------------------------------------
QAT_LOG_LEVEL=INFO
