# Copy to .env and adjust for local dev. Never commit a real .env file.
# Secrets (API keys, tokens) should be stored in the OS keyring, not here -
# see src/qat/security.py. Anything placed here is a non-secret default only.

# --- Trading mode -----------------------------------------------------
# paper (default, safe) | live (requires deliberate opt-in + in-app confirmation)
QAT_TRADING_MODE=paper

# --- Storage ------------------------------------------------------------
# sqlite (default, local dev, zero setup) | timescale (requires docker-compose up)
QAT_STORAGE_BACKEND=sqlite
QAT_DATABASE_URL=sqlite:///./qat.db
# QAT_DATABASE_URL=postgresql+psycopg://qat:qat@localhost:5433/qat

# --- IBKR (paper Gateway/TWS defaults) -----------------------------------
QAT_IBKR_HOST=127.0.0.1
QAT_IBKR_PORT=4002
QAT_IBKR_CLIENT_ID=1

# --- AI provider (M10; Settings screen writes these for you - see README) ---
# Each LLMRouter slot's provider is independent: anthropic | local | demo
QAT_GENERAL_REQUEST_PROVIDER=demo
QAT_SENSITIVE_REQUEST_PROVIDER=demo
QAT_LOCAL_LLM_BASE_URL=http://localhost:1234/v1
QAT_LOCAL_LLM_MODEL=local-model

# --- Market & watchlist (M10; Settings screen writes these for you) --------
# US | ASX
QAT_MARKET=US
# curated | etf | megacap
QAT_WATCHLIST_CATEGORY=curated
QAT_WATCHLIST_CURATED_US=SPY,AAPL,MSFT,GOOGL
QAT_WATCHLIST_CURATED_ASX=STW.AX,BHP.AX,CBA.AX,CSL.AX
QAT_WATCHLIST_MAX_SYMBOLS=10
QAT_WATCHLIST_MIN_AVG_VOLUME=100000

# --- Market data (M14/M17; Settings screen writes these for you) ------------
# synthetic (default, offline seeded random walk)
#   | yfinance (free, unofficial, ~15 min delayed)
#   | alpaca   (your Alpaca account's own feed, US equities only)
QAT_MARKET_DATA_SOURCE=synthetic
# Which Alpaca feed to request, when the source above is alpaca:
#   iex         real time, but a single exchange carrying a small share of
#               US consolidated volume. Works on a free paper account.
#   sip         the full consolidated tape. Needs a paid Algo Trader Plus
#               subscription; requesting it without one fails rather than
#               quietly degrading.
#   delayed_sip consolidated but 15 minutes behind. Free tier.
QAT_ALPACA_DATA_FEED=iex
QAT_ALPACA_POLL_SECONDS=60
QAT_YFINANCE_POLL_SECONDS=60
QAT_BAR_INTERVAL_SECONDS=60

# --- Company fundamentals (M18) ---------------------------------------------
# mock     = seeded generator. Answers every field for every symbol, which is
#            exactly why it must not be what a real decision rests on.
# yfinance = real reported figures. Anything a company does not publish - and
#            an index ETF has no earnings or return on equity at all - is left
#            empty, and the strategies that need it abstain on that symbol.
QAT_FUNDAMENTALS_SOURCE=mock
# Fundamentals move quarterly, so a week-old figure is current.
QAT_FUNDAMENTALS_CACHE_DAYS=7

# --- Broker (M12) -----------------------------------------------------------
# mock (default, no credentials) | alpaca (paper account, US equities only) | ibkr
QAT_BROKER=mock
# Alpaca credentials live in the OS keyring (ALPACA_API_KEY / ALPACA_SECRET_KEY),
# set them via the Settings screen - never here.

# Cash that a buy may never spend below. The account can never be leveraged;
# this value must stay above zero, so cash can never be fully depleted.
QAT_MIN_CASH_RESERVE=1.00

# --- Order policy (M11) ----------------------------------------------------
# Long-only by default: a "sell" only ever closes an existing holding, and a
# sell signal for a symbol you hold nothing in is dropped rather than shorted.
QAT_ALLOW_SHORT_SELLING=false
# Caps rendered blotter rows; order history itself is never truncated.
QAT_BLOTTER_MAX_ROWS=500

# --- Logging --------------------------------------------------------------
QAT_LOG_LEVEL=INFO
